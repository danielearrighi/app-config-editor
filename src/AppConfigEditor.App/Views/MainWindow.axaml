<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppConfigEditor.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="AppConfigEditor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AppConfig Editor"
        Width="1440" Height="900" MinWidth="1100" MinHeight="640">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ============================ TOOLBAR ============================ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="12,10"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="AppConfig Editor" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource OutlineBrush}" Margin="4,0" />
                    <TextBox Text="{Binding BasePath}" Width="340" VerticalAlignment="Center"
                             PlaceholderText="Cartella base dei config..." />
                    <Button Classes="ghost" Click="OnBrowseClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" />
                            <TextBlock Text="Sfoglia" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding ReloadCommand}" ToolTip.Tip="Ricarica dal disco">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="18" Height="18" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText}" Width="230" VerticalAlignment="Center"
                             PlaceholderText="Cerca chiave..." />
                    <Button Classes="ghost" Command="{Binding DiscardCommand}" ToolTip.Tip="Scarta le modifiche non salvate">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconUndo}" Width="15" Height="15" />
                            <TextBlock Text="Scarta" />
                        </StackPanel>
                    </Button>
                    <Button Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding HasChanges}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconSave}" Width="15" Height="15" />
                            <TextBlock Text="Salva" />
                            <Border Background="#33000000" CornerRadius="9" Padding="6,1"
                                    IsVisible="{Binding HasChanges}">
                                <TextBlock Text="{Binding ModifiedCount}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ CORPO ============================ -->
        <Grid Grid.Row="1" ColumnDefinitions="56,300,4,*,4,400">

            <!-- Rail icone -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10" Spacing="6" HorizontalAlignment="Center">
                    <Button Classes="rail active" Click="OnBrowseClick" ToolTip.Tip="Cartella base">
                        <PathIcon Data="{StaticResource IconFolder}" Width="20" Height="20" />
                    </Button>
                    <Button Classes="rail" Command="{Binding ReloadCommand}" ToolTip.Tip="Ricarica i file">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Sidebar albero file -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Background="{DynamicResource AppBackgroundBrush}">
                <TextBlock Grid.Row="0" Classes="section" Text="FILE | TENANT" Margin="3,3,3,3" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="3,0,3,2">
                    <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                               Text="{Binding SelectedFileCount, StringFormat='{}{0} selezionati'}" />
                    <Button Grid.Column="1" Classes="icon" Padding="4" Command="{Binding CheckAllCommand}"
                            ToolTip.Tip="Seleziona tutti i file">
                        <PathIcon Data="{StaticResource IconCheck}" Width="8" Height="8" />
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Padding="4" Command="{Binding CheckNoneCommand}"
                            ToolTip.Tip="Deseleziona tutti">
                        <PathIcon Data="{StaticResource IconClose}" Width="8" Height="8" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Padding="4" Command="{Binding ExpandAllCommand}"
                            ToolTip.Tip="Espandi tutto">
                        <PathIcon Data="{StaticResource IconExpandAll}" Width="8" Height="8" />
                    </Button>
                    <Button Grid.Column="4" Classes="icon" Padding="4" Command="{Binding CollapseAllCommand}"
                            ToolTip.Tip="Comprimi tutto">
                        <PathIcon Data="{StaticResource IconCollapseAll}" Width="8" Height="8" />
                    </Button>
                </Grid>
                <TreeView Grid.Row="2" ItemsSource="{Binding FileTree}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:FileNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FileNode">
                            <Grid ColumnDefinitions="Auto,*">
                                <CheckBox Grid.Column="0" Margin="0,0,6,0" MinWidth="0"
                                          IsVisible="{Binding IsFile}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="2" Background="{DynamicResource OutlineBrush}" ResizeDirection="Columns" />

            <!-- Elenco chiavi -->
            <Grid Grid.Column="3" RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,14,16,8">
                    <TextBlock Grid.Column="0" Classes="section" Text="CHIAVI" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource PanelAltBrush}" CornerRadius="8"
                            Padding="7,1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Keys.Count}" FontSize="11" />
                    </Border>
                    <TextBlock Grid.Column="3" Classes="hint" VerticalAlignment="Center"
                               Text="chiave · valore · divergente" />
                </Grid>
                <ListBox Grid.Row="1" Classes="table" ItemsSource="{Binding FilteredKeys}"
                         SelectedItem="{Binding SelectedKey, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyItemViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Preview}" Classes="secondary"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="tableCell" VerticalAlignment="Stretch"
                                        IsVisible="{Binding IsDivergent}">
                                    <Border Background="{DynamicResource WarnBrush}" CornerRadius="8"
                                            Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="divergente" FontSize="10" Foreground="#1B1B1B" />
                                    </Border>
                                </Border>
                                <Border Grid.Column="2" Classes="tableCell" VerticalAlignment="Stretch"
                                        ToolTip.Tip="File che contengono la chiave">
                                    <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8"
                                            Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PresentCount}" FontSize="11" />
                                    </Border>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="4" Background="{DynamicResource OutlineBrush}" ResizeDirection="Columns" />

            <!-- Pannello dettaglio -->
            <Border Grid.Column="5" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="DETAILS" />
                        <TextBlock Text="{Binding DetailHeader}" FontSize="18" FontWeight="Bold"
                                   TextWrapping="Wrap" />

                        <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,2" />

                        <TextBlock Classes="section" Text="VALORE" />
                        <TextBox Text="{Binding EditValue}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="64" MaxHeight="180" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="Il valore viene applicato solo ai file che contengono già la chiave." />

                        <TextBlock Classes="section" Text="AZIONI" Margin="0,4,0,0" />
                        <Button Classes="accent" Command="{Binding ApplyValueCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock Text="Applica ai selezionati" />
                        </Button>
                        <Button Classes="ghost" Command="{Binding ApplyValueAllCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock Text="Applica a tutti" />
                        </Button>
                        <Button Classes="ghost" Command="{Binding DeleteKeyCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Foreground="{DynamicResource DangerBrush}">
                            <TextBlock Text="Elimina dai selezionati" />
                        </Button>
                        <Button Classes="ghost" Command="{Binding DeleteKeyAllCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Foreground="{DynamicResource DangerBrush}">
                            <TextBlock Text="Elimina da tutti" />
                        </Button>

                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Classes="section" Text="PRESENZA PER FILE"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Padding="4"
                                    Command="{Binding CheckAllDetailCommand}"
                                    ToolTip.Tip="Seleziona tutti i file mostrati">
                                <PathIcon Data="{StaticResource IconCheck}" Width="8" Height="8" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon" Padding="4"
                                    Command="{Binding CheckNoneDetailCommand}"
                                    ToolTip.Tip="Deseleziona tutti i file mostrati">
                                <PathIcon Data="{StaticResource IconClose}" Width="8" Height="8" />
                            </Button>
                        </Grid>
                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding DetailRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileValueRow">
                                        <Border Classes="tableRow" Background="{DynamicResource PanelAltBrush}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox Grid.Column="0" Margin="0,0,8,0" MinWidth="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsFileSelected, Mode=TwoWay}"
                                                          ToolTip.Tip="Seleziona questo file" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Value}" Classes="secondary"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="tableCell" VerticalAlignment="Stretch"
                                                        IsVisible="{Binding IsOutlier}" ToolTip.Tip="Valore diverso dagli altri">
                                                    <Border Background="{DynamicResource WarnBrush}"
                                                            CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="≠" FontSize="12" FontWeight="Bold" Foreground="#1B1B1B" />
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Classes="section" Text="NUOVA CHIAVE" Margin="0,4,0,0" />
                        <TextBox Text="{Binding NewKeyName}" PlaceholderText="Nome chiave" />
                        <TextBox Text="{Binding NewKeyValue}" PlaceholderText="Valore" AcceptsReturn="True" TextWrapping="Wrap" />
                        <Button Classes="ghost" Command="{Binding AddKeyCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock Text="Aggiungi ai file selezionati" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================ TAB INFERIORI ============================ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0">
            <TabControl Height="176">
                <!-- Le intestazioni sono più piccole: solo i tab, non il contenuto -->
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="11" />
                    </Style>
                </TabControl.Styles>
                <TabItem Header="MODIFICHE">
                    <ListBox Classes="table compact" Margin="4" ItemsSource="{Binding Changes}" />
                </TabItem>
                <TabItem Header="LOG">
                    <ListBox Classes="table compact" Margin="4" ItemsSource="{Binding Logs}" />
                </TabItem>
                <TabItem Header="BACKUP">
                    <ListBox Classes="table compact" Margin="4" ItemsSource="{Binding Backups}" />
                </TabItem>
            </TabControl>
        </Border>

        <!-- ============================ STATUS BAR ============================ -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" Padding="12,6"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="secondary"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center"
                           Text="{Binding FileCount, StringFormat='{}{0} file AppSettings.config'}" />
            </Grid>
        </Border>
    </Grid>
</Window>
