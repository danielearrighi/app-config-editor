<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AppConfigEditor.App.App"
             xmlns:local="using:AppConfigEditor.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Accento viola applicato ai controlli Fluent -->
        <Color x:Key="SystemAccentColor">#7C5CFF</Color>
        <Color x:Key="SystemAccentColorLight1">#9277FF</Color>
        <Color x:Key="SystemAccentColorLight2">#A893FF</Color>
        <Color x:Key="SystemAccentColorLight3">#BFAFFF</Color>
        <Color x:Key="SystemAccentColorDark1">#6847E6</Color>
        <Color x:Key="SystemAccentColorDark2">#5738C2</Color>
        <Color x:Key="SystemAccentColorDark3">#462C9E</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AppConfigEditor.App/Styles/AppTheme.axaml" />
    </Application.Styles>
</Application>
